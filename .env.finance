# ============================================================
# World Monitor Finance — Cloudflare Pages Environment Variables
# ============================================================
#
# Set these in CF Dashboard → Pages → Settings → Environment variables.
# ALL are optional — the dashboard works without any of them,
# features just degrade gracefully (panels show "not configured").
#
# Copy this file to .env for local development:
#   cp .env.finance .env

# --- REQUIRED (build-time) -------------------------------------------
VITE_VARIANT=finance

# --- DATA APIs (all free tier) ----------------------------------------

# Federal Reserve Economic Data — GDP, CPI, interest rates, unemployment
# Register free: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Finnhub — live stock quotes, sector ETFs, IPO data
# Register free (60 req/min): https://finnhub.io/register
FINNHUB_API_KEY=

# Energy Information Administration — oil prices, US production, capacity
# Register free: https://www.eia.gov/opendata/register.php
EIA_API_KEY=

# --- AI SUMMARIES (pick one, both free tier) --------------------------

# Groq — fast LLM inference for article summaries
# Register free (14,400 req/day): https://console.groq.com/keys
GROQ_API_KEY=

# OpenRouter — fallback if Groq is down (pay-per-token, but cheap)
# Optional: https://openrouter.ai/keys
# OPENROUTER_API_KEY=

# --- CACHING (optional, recommended for production) -------------------

# Upstash Redis — shared cache to reduce API calls across users
# Free tier (10K commands/day): https://console.upstash.com
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
